  "constraints": [
    {
      "conname": "media_size_positive",
      "convalidated": true,
      "definition": "CHECK ((size_bytes > 0))"
    },
    {
      "conname": "order_items_amounts_consistent",
      "convalidated": true,
      "definition": "CHECK (((quantity > 0) AND (unit_price_cents >= 0) AND ((total_cents)::bigint = ((quantity)::bigint * (unit_price_cents)::bigint))))"
    },
    {
      "conname": "orders_amounts_consistent",
      "convalidated": true,
      "definition": "CHECK (((subtotal_cents >= 0) AND (shipping_cents >= 0) AND ((total_cents)::bigint = ((subtotal_cents)::bigint + (shipping_cents)::bigint))))"
    },
    {
      "conname": "product_images_position_nonnegative",
      "convalidated": true,
      "definition": "CHECK ((\"position\" >= 0))"
    },
    {
      "conname": "products_base_product_id_fkey",
      "convalidated": true,
      "definition": "FOREIGN KEY (base_product_id) REFERENCES products(id) ON DELETE SET NULL"
    },
    {
      "conname": "products_compare_price",
      "convalidated": true,
      "definition": "CHECK (((compare_at_price_cents IS NULL) OR ((price_cents IS NOT NULL) AND (compare_at_price_cents >= price_cents))))"
    },
    {
      "conname": "products_not_own_base",
      "convalidated": true,
      "definition": "CHECK (((base_product_id IS NULL) OR (base_product_id <> id)))"
    },
    {
      "conname": "products_price_positive",
      "convalidated": true,
      "definition": "CHECK (((price_cents IS NULL) OR (price_cents > 0)))"
    },
    {
      "conname": "products_stock_nonnegative",
      "convalidated": true,
      "definition": "CHECK (((stock_quantity IS NULL) OR (stock_quantity >= 0)))"
    },
    {
      "conname": "products_unique_piece_stock",
      "convalidated": true,
      "definition": "CHECK (((condition <> ALL (ARRAY['imperfect'::product_condition, 'used'::product_condition])) OR (stock_quantity IS NULL) OR (stock_quantity <= 1)))"
    }
  ],
