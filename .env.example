NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KayArt
KAYART_DATA_SOURCE=mock
# Enable indexing only on the public production site with its exact HTTPS origin above.
# Previews and mock data remain excluded even when this flag is true.
KAYART_INDEXING_ENABLED=false
# Enable only against an isolated test database. No stock or real payments are processed.
KAYART_ENABLE_ORDER_SIMULATOR=false

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Product images
# Local dev can stay empty. Use "supabase" on Vercel and create a public bucket with this name.
KAYART_IMAGE_STORAGE=
SUPABASE_STORAGE_BUCKET=product-images
# Optional dedicated HMAC secret; otherwise the server Supabase key is used.
PRODUCT_IMAGE_RECEIPT_SECRET=

# Prisma/PostgreSQL
# Runtime connection, usually transaction-mode pooler in hosted/serverless environments.
DATABASE_URL=

# Migration/schema connection, usually direct or session-mode pooler.
DIRECT_URL=

# Legacy Supabase keys, only if needed for a specific SDK/API.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public requests: persistent anti-spam. Optional dedicated secret (server only).
REQUEST_RATE_LIMIT_SECRET=

# Stripe TEST ONLY. Keep disabled until a dedicated KayArt test account and webhook are configured.
# Use an isolated test database/catalog: Checkout reserves inventory, even in test mode.
KAYART_CHECKOUT_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Protect GET /api/cron/checkouts; schedule externally, for example every 5 minutes.
CRON_SECRET=

# Legal publication: all values must be real and approved. No placeholder defaults.
KAYART_LEGAL_APPROVED=false
KAYART_LEGAL_NAME=
KAYART_LEGAL_FORM=
KAYART_LEGAL_ADDRESS=
KAYART_LEGAL_REGISTRATION=
KAYART_LEGAL_TAX_STATEMENT=
KAYART_PUBLICATION_DIRECTOR=
KAYART_CONSUMER_MEDIATOR=
KAYART_STANDARD_TERMS=
KAYART_CUSTOM_TERMS=
KAYART_PRIVACY_BASIS=
KAYART_PRIVACY_RETENTION=
KAYART_PRIVACY_RECIPIENTS=
KAYART_HOSTING_STATEMENT=
KAYART_LEGAL_VERSION=

# Email delivery is not configured by this integration.
EMAIL_FROM=
