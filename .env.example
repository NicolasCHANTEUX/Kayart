NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KayArt
KAYART_DATA_SOURCE=mock

# Supabase
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Product images
# Local dev can stay empty. Use "supabase" on Vercel and create a public bucket with this name.
KAYART_IMAGE_STORAGE=
SUPABASE_STORAGE_BUCKET=product-images

# Prisma/PostgreSQL
# Runtime connection, usually transaction-mode pooler in hosted/serverless environments.
DATABASE_URL=

# Migration/schema connection, usually direct or session-mode pooler.
DIRECT_URL=

# Legacy Supabase keys, only if needed for a specific SDK/API.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future services
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EMAIL_FROM=
